{
  "id": "com.linus.msdistress",
  "name": "MS Distress",
  "version": "1.4.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "PS", "minVersion": "24.2.0" },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "distressPanel",
      "label": { "default": "MS Distress" },
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 900, "height": 4000 },
      "preferredDockedSize": { "width": 320, "height": 760 },
      "preferredFloatingSize": { "width": 340, "height": 820 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
